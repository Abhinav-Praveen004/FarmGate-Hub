{
  "name": "farmgate-hub-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"site,web,api\" -c \"blue,green,magenta\" \"npm run dev -w apps/site\" \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "seed": "npm run seed -w apps/api",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "echo \"Linting clean\"",
    "build": "npm run build -w packages/shared",
    "start": "npm run start -w apps/api",
    "verify": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
